# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables.

# Required: your Google AI Studio API key (Gemini).
GEMINI_API_KEY=

# Optional: a shared password for the whole site. Leave empty for no password.
# Anyone with the link can otherwise run generations on your Gemini account.
APP_PASSWORD=

# Optional: test the whole flow without calling Gemini (images are crops of the KV).
MOCK_AI=false

# Optional: how long projects are kept before automatic deletion (days).
RETENTION_DAYS=30

# Optional: starting model names (you can also change these in the app under Prompt library > Settings).
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_QC_MODEL=gemini-3.1-pro-preview

# Set automatically when you connect a Vercel Blob store to the project.
# Locally, run `vercel env pull` or leave empty to store files in ./.data
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
